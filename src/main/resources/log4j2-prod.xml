<?xml version="1.0" encoding="UTF-8"?>
<Configuration name="Spring Boot demo" packages=""
  status="warn">
  <Appenders>
    <RollingFile fileName="${baseDir}/${baseName}.log" filePattern="${baseDir}/$${date:yyyy-MM}/${baseName}-%d{yyyy-MM-dd}-%i.log.gz"
      name="RollingFile">
      <DefaultRolloverStrategy max="100">
        <Delete basePath="${baseDir}" maxDepth="2">
          <IfFileName glob="*/${baseName}-*.log.gz">
            <IfLastModified age="365d">
              <IfAny>
                <IfAccumulatedFileCount exceeds="10"/>
                <IfAccumulatedFileSize exceeds="100 GB"/>
              </IfAny>
            </IfLastModified>
          </IfFileName>
        </Delete>
      </DefaultRolloverStrategy>
      <PatternLayout
        pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36}.%M\:%line - %msg%n"/>
      <Policies>
        <SizeBasedTriggeringPolicy size="20 MB"/>
        <TimeBasedTriggeringPolicy/>
      </Policies>
    </RollingFile>
  </Appenders>
  <Loggers>
    <Logger level="INFO" name="org.springframework.web"/>
    <Logger level="DEBUG" name="org.hibernate.SQL"/>
    <Logger level="TRACE" name="org.hibernate.type.descriptor.sql"/>
    <Root level="INFO">
      <AppenderRef ref="RollingFile"/>
    </Root>
  </Loggers>
  <Properties>
    <Property name="baseDir">logs</Property>
    <Property name="baseName">demo</Property>
  </Properties>
</Configuration>